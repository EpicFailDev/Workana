{
  "manifest_version": 3,
  "name": "Workana Accelerator • AI Copilot & Auto-Bid Pro",
  "short_name": "Workana AI Pro",
  "version": "2.0.0",
  "description": "Copilot autônomo com IA para Workana: propostas personalizadas de alto fechamento, envio seguro anti-ban em 1.8s e sincronização contínua de sessão.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://*.workana.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.workana.com/*"],
      "js": ["content_workana.js"],
      "css": ["copilot.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "https://localhost:5173/*",
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "http://workana.duckdns.org/*",
        "https://workana.duckdns.org/*"
      ],
      "js": ["content_accelerator.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["copilot.css", "icons/*"],
      "matches": ["*://*.workana.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Workana Accelerator • AI Copilot Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
